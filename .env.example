# --- CMS (leave DATABASE_URI empty to run the site on built-in seed content) ---
DATABASE_URI=postgres://payload:payload@localhost:5432/ascendit
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Media (Azure Blob behind the CDN) ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=media
AZURE_STORAGE_ACCOUNT_BASEURL=

# --- Lead pipeline ---
N8N_LEAD_WEBHOOK=
N8N_SHARED_SECRET=
N8N_EVENTS_WEBHOOK=
REVALIDATE_SECRET=
PREVIEW_SECRET=
CRON_SECRET=

# --- Spam protection (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Ads conversion (Meta CAPI). gclid is forwarded to n8n for Google Ads offline upload ---
META_PIXEL_ID=
META_CAPI_TOKEN=

# --- Showreel streaming ---
NEXT_PUBLIC_MUX_SHOWREEL_PLAYBACK_ID=

# --- Analytics ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
