    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-azure": "3.90.2",
    "graphql": "^16.14.2",
    "gsap": "^3.15.0",
    "motion": "^14.0.0",
    "next": "15.4.11",
    "payload": "3.90.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
